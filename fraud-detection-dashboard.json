{
  "dashboard": {
    "title": "Fraud Detection Logs",
    "uid": "fraud-detection-logs",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "type": "logs",
        "title": "All Logs",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 12
        },
        "targets": [
          {
            "expr": "{service=\"fraud_detection\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": false,
          "sortOrder": "Descending",
          "dedupStrategy": "none",
          "enableLogDetails": true
        }
      },
      {
        "id": 2,
        "type": "logs",
        "title": "Error Logs",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "{service=\"fraud_detection\", level=\"error\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": false,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 3,
        "type": "logs",
        "title": "Warning Logs",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "{service=\"fraud_detection\", level=\"warn\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": false,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Log Count by Level",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 24,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum by (level) (count_over_time({service=\"fraud_detection\"}[5m]))",
            "refId": "A",
            "legendFormat": "{{level}}"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    }
  },
  "overwrite": true
}